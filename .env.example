# ==============================================================================
# YourApp Backend Environment Variables
# ==============================================================================

# --- Infrastructure ---
SERVER_ADDR=0.0.0.0:3000

# --- Databases ---
IDENTITY_DATABASE_URL=postgres://postgres@localhost:5432/your_app_identity
AUTH_DATABASE_URL=postgres://postgres@localhost:5432/your_app_auth
EMAIL_DATABASE_URL=postgres://postgres@localhost:5432/your_app_email
EMAIL_AMQP_URL=amqp://127.0.0.1:5672/%2f

# --- Gateway CORS Configuration ---
# Restricts incoming cross-origin requests in production builds. Supports a comma-separated list.
ALLOWED_CORS_ORIGINS=https://your_app.local,https://admin.your_app.local

# --- Human Verification Secrets ---
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# --- OAuth Secrets ---
GOOGLE_CLIENT_ID=123456789012-abc123def456ghi789jkl.apps.googleusercontent.com
