# ==============================================================================
# YourApp Backend Environment Variables
# ==============================================================================

# --- Infrastructure ---
GATEWAY_ADDRESS=0.0.0.0:3000

# --- Internal gRPC Subsystem Endpoints ---
IDENTITY_SERVICE_URL=http://identity:50051
AUTH_SERVICE_URL=http://auth:50052
EMAIL_SERVICE_URL=http://email:50053
ACCESS_TOKENS_SERVICE_URL=http://access_tokens:50054
HUMAN_VERIFICATION_SERVICE_URL=http://human_verification:50055

# --- Databases & Message Broker ---
IDENTITY_DATABASE_URL=postgres://postgres@postgres:5432/your_app_identity
AUTH_DATABASE_URL=postgres://postgres@postgres:5432/your_app_auth
EMAIL_DATABASE_URL=postgres://postgres@postgres:5432/your_app_email

AUTH_AMQP_URL=amqp://guest:guest@rabbitmq:5672/%2f
EMAIL_AMQP_URL=amqp://guest:guest@rabbitmq:5672/%2f

# --- Telemetry & Distributed Tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Gateway CORS Configuration ---
# Restricts incoming cross-origin requests in production builds. Supports a comma-separated list.
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Human Verification Secrets ---
HUMAN_VERIFICATION_SECRET=your_human_verification_secret_32char
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret

# --- OAuth Secrets ---
GOOGLE_CLIENT_ID=your_google_client_id

# --- SMTP Configuration ---
SMTP_HOST=mailpit
SMTP_PORT=1025
