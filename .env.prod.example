# =======================================================
# YourApp Backend Environment Variables
# =======================================================

# --- Database Credentials ---
DB_PASSWORD=your_database_password

# --- RabbitMQ Credentials ---
RABBITMQ_USER=your_app_admin
RABBITMQ_PASSWORD=your_rabbitmq_password

# --- Infrastructure ---
GATEWAY_ADDRESS=0.0.0.0:3000

# --- Internal gRPC Subsystem Endpoints ---
IDENTITY_SERVICE_URL=http://identity:50051
AUTH_SERVICE_URL=http://auth:50052
EMAIL_SERVICE_URL=http://email:50053
ACCESS_TOKENS_SERVICE_URL=http://access_tokens:50054
HUMAN_VERIFICATION_SERVICE_URL=http://human_verification:50055

# --- Databases ---
IDENTITY_DATABASE_URL=postgres://postgres:${DB_PASSWORD}@postgres:5432/your_app_identity
AUTH_DATABASE_URL=postgres://postgres:${DB_PASSWORD}@postgres:5432/your_app_auth
EMAIL_DATABASE_URL=postgres://postgres:${DB_PASSWORD}@postgres:5432/your_app_email

# --- Message Broker ---
AUTH_AMQP_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2f
EMAIL_AMQP_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2f

# --- Telemetry & Distributed Tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Gateway CORS Configuration ---
# Restricts incoming cross-origin requests in production builds. Supports a comma-separated list.
ALLOWED_CORS_ORIGINS=https://your_app.online,https://www.your_app.online,https://api.your_app.online

# --- Human Verification Secrets ---
HUMAN_VERIFICATION_SECRET=your_32_character_secret
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# --- Access Token Secrets ---
ACCESS_TOKENS_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----"

# --- OAuth Secrets ---
GOOGLE_CLIENT_ID=123456789012-abc123def456ghi789jkl.apps.googleusercontent.com

# --- Production SMTP ---
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=AKIAXXXXXXXXXXXXXXXX
SMTP_PASSWORD=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
